# ─── Frontend (Vite) ────────────────────────────────────────────────────
# Base de la API. Por defecto el cliente usa:
#   · dev:  http://localhost:3000/api
#   · prod: /api
# Solo define esto si necesitas sobreescribir el default (raro).
# VITE_API_URL=http://localhost:3000/api

# NOTA: el backend tiene su propio .env en ./backend/.env
#       (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY) — NUNCA se commitea.
